{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd learning-objective-extractor/frontend && npm install && npm run build",
  "outputDirectory": "learning-objective-extractor/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
