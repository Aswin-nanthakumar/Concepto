# ---- Learning Objective Extractor: backend env ----
# Copy to .env and fill in. NEVER commit real secrets.
APP_NAME=Learning Objective Extractor
ENV=production
DEBUG=false
PYTHONPATH=.


# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=90

MAX_UPLOAD_MB=15
MAX_TEXT_CHARS=120000

# Comma-separated; use your Vercel URL in production
CORS_ORIGINS=*
FRONTEND_URL=http://localhost:5173

DATABASE_URL=sqlite:///./loe.db
STORAGE_DIR=./storage
