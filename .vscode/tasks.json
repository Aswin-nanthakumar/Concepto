{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Antigravity: Backend (FastAPI)",
      "type": "shell",
      "command": "cmd.exe /c \"cd /d ${workspaceFolder}\\learning-objective-extractor\\backend && call .venv\\Scripts\\activate.bat && uvicorn app.main:app --reload --port 8000\"",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "servers",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Antigravity: Frontend (Vite)",
      "type": "shell",
      "command": "cmd.exe /c \"cd /d ${workspaceFolder}\\learning-objective-extractor\\frontend && npm.cmd run dev\"",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "servers",
        "clear": true,
        "showReuseMessage": false
      }
    },
    {
      "label": "Run All (Separate Terminals)",
      "dependsOn": [
        "Antigravity: Backend (FastAPI)",
        "Antigravity: Frontend (Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
