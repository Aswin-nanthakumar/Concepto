APP_NAME=Concepto
ENV=development
DEBUG=true
PYTHONPATH=.

# Get a key at https://aistudio.google.com/apikey (optional — offline engine works without it)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=90

MAX_UPLOAD_MB=15
MAX_TEXT_CHARS=120000

# Local CORS
CORS_ORIGINS=*
FRONTEND_URL=http://localhost:5173

DATABASE_URL=sqlite:///./loe.db
STORAGE_DIR=./storage
